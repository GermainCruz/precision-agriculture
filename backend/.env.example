# Base de datos PostgreSQL (misma cadena usarás en credencial Postgres dentro de n8n: host localhost + esta base/usuario/clave)
DATABASE_URL="postgresql://postgres:password@localhost:5432/agricultura_db"

# JWT
JWT_SECRET="agriprecision-secret-change-in-production"

# Servicio ML — local típico: http://127.0.0.1:5000
ML_SERVICE_URL="http://127.0.0.1:5000"

# Frontend (CORS)
FRONTEND_URL="http://localhost:3000"

# Puerto del backend
PORT=4000

# OpenWeather (workflow n8n de clima; también puedes definir OPENWEATHER_API_KEY en .env raíz del repo con prioridad)
# OPENWEATHER_API_KEY=

# Opcional: misma clave que uses en scripts n8n (n8n-workflows/run-local.bat carga esta carpeta antes que .env raíz)
# N8N_ENCRYPTION_KEY=tu-frase-estable-minimo-32-caracteres

