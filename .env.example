# Database
DATABASE_URL="postgresql://admin:secure_password@postgres:5432/agricultura_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ML Service — local (sin Docker): http://127.0.0.1:5000
# En Docker Compose suele ser: http://ml-service:5000
ML_SERVICE_URL="http://127.0.0.1:5000"

# Ejecutar predicciones automáticas cada noche (requiere ML arriba). Por defecto desactivado.
# ENABLE_PREDICTION_CRON="true"

# External APIs
OPENWEATHER_API_KEY="your-openweather-api-key"

# n8n
N8N_WEBHOOK_URL="http://n8n:5678/webhook"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Email (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
